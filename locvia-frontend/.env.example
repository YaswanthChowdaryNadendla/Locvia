# Locvia Grocery Delivery Platform - Frontend Environment Configuration
# Copy this file to .env.local or .env for local development with Spring Boot backend.

# Spring Boot REST API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Feature flag to switch from local mock data to real Spring Boot backend API
# Set to 'true' when Spring Boot backend (Module 45) is running locally or in production.
# Default is 'false' (uses existing mock & localStorage data seamlessly).
VITE_ENABLE_API=false

# Google Identity Services (OAuth 2.0 Client ID for Web Applications)
# Public client ID configured in Google Cloud Console.
# Authorized JavaScript Origins: http://localhost:5173, https://locvia-platform.vercel.app
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

